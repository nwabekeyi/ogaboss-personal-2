model Order {
  id                    String          @id @default(cuid())
  transactionId         String          @unique
  cryptoAmountBase      Decimal?        @db.Decimal(78, 0)
  cryptoAmountOriginal  String?
  fiatAmountBase        Decimal         @db.Decimal(78, 0)
  fiatAmountOriginal    String?
  fiatCurrency          String          @default("NGN")
  status                OrderStatus     @default(PENDING)
  type                  OrderType       @default(BUY)
  referenceNo           String?
  paymentStatus         PaymentStatus   @default(PENDING)
  paymentReference      String?
  paymentChannel        String?
  paymentAmountBase     Decimal?        @db.Decimal(78, 0)
  paymentAmountOriginal String?
  paymentDate           DateTime?
  gatewayResponse       String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  user                  User            @relation(fields: [userId], references: [id])
  userId                String
  currency              CryptoCurrency? @relation(fields: [currencyId], references: [id])
  currencyId            String?

  @@index([transactionId])
  @@index([referenceNo])
  @@index([referenceNo, status])
  @@index([paymentReference])
  @@index([createdAt])
  @@index([status])
  @@index([userId])
  @@index([currencyId])
  @@map("orders")
}