model TempStore {
  id             String   @id @default(cuid())
  key            String   @unique @db.VarChar(255)
  value          String   @db.VarChar(255)
  expirationTime Int?
  beginTime      DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([key])
  @@index([value])
  @@index([expirationTime])
  @@index([beginTime])
  @@map("temp_stores")
}
