model UrgentLiquiditySettings {
  id                    String           @id @default(cuid())
  maxLoanRequest        Decimal          @default(100000) @db.Decimal(78, 0)
  loanFeePercent        Decimal          @default(5) @db.Decimal(5, 2)
  settlementPercent     Decimal          @default(10) @db.Decimal(5, 2)
  collateralPercent     Decimal          @default(15) @db.Decimal(5, 2)
  liquidationDeadlineDays Int            @default(7)
  liquidationFeePercent Decimal          @default(5) @db.Decimal(5, 2)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  repaymentRanges       RepaymentRange[]

  @@map("urgent_liquidity_settings")
}

model RepaymentRange {
  id                     String                 @id @default(cuid())
  settingsId             String
  fromAmount             Decimal                @db.Decimal(78, 0)
  toAmount               Decimal                @db.Decimal(78, 0)
  repaymentDurationDays  Int
  currency               String                 @default("NGN")
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  settings               UrgentLiquiditySettings @relation(fields: [settingsId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "repayment_range_settings_fkey")

  @@unique([settingsId, currency, fromAmount, toAmount])
  @@index([settingsId])
  @@index([currency])
  @@map("repayment_ranges")
}