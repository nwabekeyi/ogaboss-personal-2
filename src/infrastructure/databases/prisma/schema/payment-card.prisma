model PaymentCard {
  id                String   @id @default(cuid())
  userId            String
  authorizationCode String
  authorizationIv   String
  authorizationTag  String
  cardType          String?
  last4             String?
  expMonth          Int?
  expYear           Int?
  reusable          Boolean?
  bank              String?
  channel           String?
  label             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([userId, last4, expMonth, expYear, cardType])
  @@map("payment_cards")
}
