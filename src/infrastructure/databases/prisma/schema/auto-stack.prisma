model AutoStack {
  id                 String             @id @default(cuid())
  userId             String
  currencyId         String
  planName           String
  frequency          AutoStackFrequency
  amount             Decimal            @db.Decimal(78, 0)
  startDate          DateTime
  timeOfDay          String
  dayOfWeek          String?
  dayOfMonth         Int?
  transactionFee     Decimal            @default(0) @db.Decimal(78, 0)
  accruedInterest    Decimal            @default(0) @db.Decimal(78, 0)
  status             AutoStackStatus    @default(ACTIVE)
  lastExecutedAt     DateTime?
  nextExecutionAt    DateTime
  nextInterestAt     DateTime           @default(now())
  endedAt            DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  user               User               @relation(fields: [userId], references: [id])
  cryptoCurrency     CryptoCurrency     @relation(fields: [currencyId], references: [id])

  @@index([userId, status])
  @@index([nextExecutionAt, status])
  @@index([status, nextInterestAt])
  @@map("auto_stacks")
}
