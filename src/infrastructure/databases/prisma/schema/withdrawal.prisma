model Withdrawal {
  id                   String           @id @default(cuid())
  userId               String
  user                 User             @relation(fields: [userId], references: [id])
  providerWithdrawalId String?           @unique
  reference            String?          @unique
  txHash               String?
  currency             String
  network              String?
  amount               Decimal
  fee                  Decimal?
  total                Decimal?
  recipientType        String?
  recipientAddress     String?
  destinationTag       String?
  recipientUserId      String?
  narration            String?
  transactionNote      String?
  status               WithdrawalStatus @default(PENDING)
  reason               String?
  rawPayload           Json?
  createdAtProvider    DateTime
  completedAtProvider  DateTime?
  transactionId        String? // new foreign key
  transaction          Transaction?     @relation(fields: [transactionId], references: [id], name: "TransactionToWithdrawal")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, currency])
  @@index([providerWithdrawalId])
  @@index([txHash])
  @@index([reference])
  @@map("withdrawals")
}
