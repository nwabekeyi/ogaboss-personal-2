model CompanyLiquidity {
  id              String   @id @default(cuid())
  totalBalance    Decimal  @default(0) @db.Decimal(78, 0)
  reservedBalance Decimal  @default(0) @db.Decimal(78, 0)
  internalBalance Decimal  @default(0) @db.Decimal(78, 0)
  totalLockedPrincipal Decimal @default(0) @db.Decimal(78, 0)
  totalAccruedLockedInterest Decimal @default(0) @db.Decimal(78, 0)
  totalInterestPaid Decimal @default(0) @db.Decimal(78, 0)
  totalLockedInterestPaid Decimal @default(0) @db.Decimal(78, 0)
  totalAmountStacked Decimal @default(0) @db.Decimal(78, 0)
  totalStackedInterestPaid Decimal @default(0) @db.Decimal(78, 0)
  currency        String   @unique
  network         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([currency])
  @@map("company_liquidity")
}