model Notification {
  id        String    @id @default(cuid())
  userId    String
  title     String
  body      String
  data      Json?
  imageUrl  String?
  isRead    Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId])
  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}
