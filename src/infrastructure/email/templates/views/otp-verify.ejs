<div style="margin:24px 0;">
  <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
    <tr>
      <td style="background:#f8fafc;border:2px solid #e2e8f0;border-radius:12px;padding:28px 16px;text-align:center;">
        <p style="margin:0 0 8px;font-size:12px;color:#94a3b8;text-transform:uppercase;letter-spacing:1.5px;font-weight:600;font-family:'Segoe UI',Roboto,Helvetica,Arial,sans-serif;">Your verification code</p>
        <p style="margin:0;font-size:36px;font-weight:800;letter-spacing:8px;color:#0f172a;font-family:'Courier New',Courier,monospace;"><%= otp %></p>
      </td>
    </tr>
  </table>
  <p style="margin:16px 0 0;font-size:14px;color:#64748b;text-align:center;font-family:'Segoe UI',Roboto,Helvetica,Arial,sans-serif;">
    This code expires in <strong style="color:#0f172a;"><%= timeLeft %> minutes</strong>
  </p>
</div>
