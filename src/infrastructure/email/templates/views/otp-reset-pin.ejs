<div style="margin:24px 0;">
  <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
    <tr>
      <td style="background:#ecfeff;border:2px solid #a5f3fc;border-radius:12px;padding:28px 16px;text-align:center;">
        <p style="margin:0 0 8px;font-size:12px;color:#0891b2;text-transform:uppercase;letter-spacing:1.5px;font-weight:600;font-family:'Segoe UI',Roboto,Helvetica,Arial,sans-serif;">Your PIN reset code</p>
        <p style="margin:0;font-size:36px;font-weight:800;letter-spacing:8px;color:#155e75;font-family:'Courier New',Courier,monospace;"><%= otp %></p>
      </td>
    </tr>
  </table>
  <p style="margin:16px 0 0;font-size:14px;color:#64748b;text-align:center;font-family:'Segoe UI',Roboto,Helvetica,Arial,sans-serif;">
    Code expires in <strong style="color:#155e75;"><%= timeLeft %> minutes</strong>
  </p>
</div>
