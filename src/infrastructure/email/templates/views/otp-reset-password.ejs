<div style="margin:24px 0;">
  <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
    <tr>
      <td style="background:#fff7ed;border:2px solid #fed7aa;border-radius:12px;padding:28px 16px;text-align:center;">
        <p style="margin:0 0 8px;font-size:12px;color:#ea580c;text-transform:uppercase;letter-spacing:1.5px;font-weight:600;font-family:'Segoe UI',Roboto,Helvetica,Arial,sans-serif;">Your password reset code</p>
        <p style="margin:0;font-size:36px;font-weight:800;letter-spacing:8px;color:#9a3412;font-family:'Courier New',Courier,monospace;"><%= otp %></p>
      </td>
    </tr>
  </table>
  <p style="margin:16px 0 0;font-size:14px;color:#64748b;text-align:center;font-family:'Segoe UI',Roboto,Helvetica,Arial,sans-serif;">
    Code expires in <strong style="color:#9a3412;"><%= timeLeft %> minutes</strong>
  </p>
</div>
